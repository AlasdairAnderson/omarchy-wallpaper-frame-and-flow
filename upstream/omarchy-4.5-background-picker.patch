+  // A background clone can opt its own overlay into background selection.
+  // Resolve on every request: disable/remove needs no persistent menu edits.
+  function backgroundPickerId() {
+    var id = resolveEnabledId("omarchy.background")
+    var manifest = installedPlugins[id]
+    if (!manifest || !isEnabled(id)) return ""
+    var metadata = Util.isPlainObject(manifest.omarchy) ? manifest.omarchy : {}
+    if (metadata.clonedFrom !== "omarchy.background" || metadata.backgroundPicker !== true)
+      return ""
+    if (!Array.isArray(manifest.kinds) || manifest.kinds.indexOf("overlay") === -1)
+      return ""
+    return manifest.entryPoints && isSafeEntryPoint(manifest.entryPoints.overlay) ? id : ""
   }
 
